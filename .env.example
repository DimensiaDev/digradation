# ──────────────────────────────────────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────────────────────────────────────

# Set debug mode. Debug allows insecure cookies.
# ⚠️ CHANGE TO 0 IN PRODUCTION
DEBUG=1

# Public URLs where the app is reachable. UPDATE IN PRODUCTION.
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:8080

# Ports the app listens on.
BACKEND_PORT=3000
FRONTEND_PORT=8080

# ──────────────────────────────────────────────────────────────────────────────
# Database (PostgreSQL)
# ──────────────────────────────────────────────────────────────────────────────

# ⚠️ SET A SECURE VALUE — generate with `openssl rand -hex 48`
POSTGRES_PASSWORD=

POSTGRES_USER=digradation
POSTGRES_DB=digradation

# ──────────────────────────────────────────────────────────────────────────────
# Message broker (RabbitMQ)
# ──────────────────────────────────────────────────────────────────────────────

# ⚠️ SET A SECURE VALUE — generate with `openssl rand -hex 48`
RABBITMQ_PASS=

RABBITMQ_USER=admin
RABBITMQ_MANAGEMENT_PORT=15672

# ──────────────────────────────────────────────────────────────────────────────
# Task monitoring (TaskIQ)
# ──────────────────────────────────────────────────────────────────────────────

# ⚠️ SET A SECURE VALUE — generate with `openssl rand -hex 48`
TASKIQ_API_TOKEN=

TASKIQ_DASHBOARD_PORT=8000

# ──────────────────────────────────────────────────────────────────────────────
# GigaChat (Sber)
# ──────────────────────────────────────────────────────────────────────────────

# Get these from https://developers.sber.ru/docs/ru/gigachat/api/reference/rest/post-token
# Scope is one of: PERS, B2B, CORP, openai, mock.
#   PERS/B2B/CORP -> GigaChat client
#   openai        -> OpenAI-compatible client (token in SBER_API_KEY)
#   mock          -> offline stand-in, no network calls
SBER_API_KEY=mock
SBER_API_SCOPE=PERS

# See https://developers.sber.ru/docs/ru/gigachat/models/main
GIGACHAT_MODEL=GigaChat-3-Ultra

# OpenAI-compatible client, used when SBER_API_SCOPE=openai. OPENAI_URL is required
# in that mode; there is no implicit public endpoint.
# OPENAI_URL=https://hub.gigaschool.ru/api/v1/llm/v1
# OPENAI_MODEL=GigaChat/GigaChat-3-Pro

# Search service of the deployment, for the agent's online search. Without it the
# encyclopedia answers; the service answers the same request and the same response,
# so the backend does not change with it.
# WEB_SEARCH_URL=https://search.example/api

# Embedding model exposed by the school-hub router. Used only when
# SBER_API_SCOPE=openai. The GigaChat client (PERS/B2B/CORP) has no
# embeddings endpoint, so these variables are meaningless in that mode.
OPENAI_EMBEDDING_MODEL=ai-sage/Giga-Embeddings-instruct-3B
OPENAI_EMBEDDING_DIMENSION=2048

# RAG search in programme stages. Off by default: enable it only after
# `python index_rag.py` has built the index and the scope is `openai` (the
# GigaChat-native modes have no embeddings endpoint).
RAG_ENABLED=false
RAG_OVERSAMPLE=4
# The floor a fragment has to clear. Measured on this corpus: an unrelated query
# scores about 0.18 and a related one about 0.44, so 0.30 keeps the two apart.
RAG_MIN_SCORE=0.30
RAG_MAX_PER_SOURCE=3

# ──────────────────────────────────────────────────────────────────────────────
# Object storage (Garage, S3-compatible)
# ──────────────────────────────────────────────────────────────────────────────

# ⚠️ SET A SECURE VALUE — this is the secret half of the application's S3
#    credentials and Garage is exposed in production. Generate with
#    `openssl rand -hex 48`
#    Garage will not let a key id be reused with a different secret, so
#    rotating this means also changing S3_ACCESS_KEY to a new unused id.
S3_SECRET_KEY=

# The key id Garage imports for the application. Must be "GK" followed by 26 hex
# characters. Any unused value works; it is pinned so the backend can read it
# from the environment with no credential handoff at startup.
S3_ACCESS_KEY=GKd1a1b2c3d4e5f60718293a4b5c6d

# Arbitrary, but must match `s3_region` in conf/garage.toml.
S3_REGION=garage

# Endpoint baked into presigned URLs. The browser fetches these directly, so it
# must be reachable from the user's machine. UPDATE IN PRODUCTION.
S3_PUBLIC_URL=http://localhost:3900

# Host port the S3 API is published on.
S3_PORT=3900

# Garage's own RPC secret and admin API token. Both are required by the server
# container and BOTH must be exactly 32 bytes of hex (64 characters) — Garage
# refuses to start otherwise, so use `-hex 32` here and not the `-hex 48` used
# for the other secrets.
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

# Host port for the Garage admin API.
GARAGE_ADMIN_PORT=3903

# Browser origins allowed to call the buckets directly, comma-separated. The
# browser reaches the object store through presigned URLs, so every upload and
# download is cross-origin. Garage applies no default CORS policy and rejects an
# unmatched preflight with 403, so these rules are applied by `garage-config`.
# The default `*` is safe only because the buckets are private and reachable
# solely through presigned URLs. UPDATE IN PRODUCTION.
S3_CORS_ORIGINS=*
