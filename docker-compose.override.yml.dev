services:
  backend:
    volumes:
      - ./backend:/app
    environment:
      WATCHFILES_FORCE_POLLING: "true"

  frontend:
    build:
      target: build
    working_dir: /app
    volumes:
      - ./frontend:/app
      - /app/node_modules
    command: npm run start -- --host 0.0.0.0 --port 80 --poll 1000
    environment:
      CHOKIDAR_USEPOLLING: "true"

  db:
    # 5433, not 5432: the base file publishes no database port at all, and a
    # developer may already be running PostgreSQL on the host's 5432. This
    # override is what makes the database reachable from the host, which the
    # makemigrations scripts need, and it must not land on a port that is
    # already taken by something that is not ours.
    ports:
      - 5433:5432
