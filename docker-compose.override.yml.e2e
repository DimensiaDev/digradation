services:
  frontend:
    # `!override`, not a plain list. Compose MERGES a service's ports across files,
    # so a plain list here leaves the base file's 8080 binding in place and the
    # container fails to start whenever a dev stack already holds 8080. The tag
    # replaces the list instead of extending it.
    ports: !override
      # A distinct port so an e2e run never collides with a development stack.
      - "${E2E_FRONTEND_PORT:-18080}:80"
    build:
      args:
        BACKEND_URL: ""
    environment:
      E2E: "1"

  backend:
    ports: !reset []
    environment:
      # The offline provider: no GigaChat calls, no credentials, deterministic
      # output. Every request still exercises the real router, the real workers
      # and the real Garage/Redis/PostgreSQL stack.
      SBER_API_KEY: "mock"
      SBER_API_SCOPE: "PERS"
      MOCK_PROVIDER_MODE: "${E2E_MOCK_MODE:-ok}"
      DEBUG: "0"
      # Presigned upload and download URLs are built from S3_PUBLIC_URL, and the
      # browser follows them straight to object storage. It has to point at the
      # port `garage` publishes below, not at the dev default of 3900.
      S3_PUBLIC_URL: "http://localhost:${E2E_S3_PORT:-13900}"

  migrate:
    environment:
      SBER_API_KEY: "mock"
      SBER_API_SCOPE: "PERS"

  # The mode has to reach the workers, not just the API: the programme stages are
  # generated in the worker processes, so `E2E_MOCK_MODE=stage` on `backend` alone
  # would leave every stage answering like the ordinary chat.
  scheduler:
    environment:
      SBER_API_KEY: "mock"
      SBER_API_SCOPE: "PERS"
      MOCK_PROVIDER_MODE: "${E2E_MOCK_MODE:-ok}"

  worker_default:
    environment:
      SBER_API_KEY: "mock"
      SBER_API_SCOPE: "PERS"
      MOCK_PROVIDER_MODE: "${E2E_MOCK_MODE:-ok}"

  worker_network:
    environment:
      SBER_API_KEY: "mock"
      SBER_API_SCOPE: "PERS"
      MOCK_PROVIDER_MODE: "${E2E_MOCK_MODE:-ok}"

  taskiq_dashboard:
    ports: !reset []

  rabbitmq:
    ports: !reset []

  garage:
    # The one port that MUST be published: the browser uploads and downloads
    # through presigned URLs, so nothing in the container boundary can stand in
    # for it. It gets a dedicated port rather than the dev 3900 for the same
    # reason the frontend gets 18080 -- a running dev stack holds 3900, and a
    # test that quietly reaches the developer's Garage proves nothing.
    # `!override`, not `!reset []`, for the merge reason spelled out above.
    ports: !override
      - "${E2E_S3_PORT:-13900}:3900"
